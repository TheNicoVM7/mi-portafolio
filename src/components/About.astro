---
import AnimateOnScroll from "./AnimateOnScroll";
---

<section id="sobre-mi">
    <div class="container">
        <AnimateOnScroll client:load>
            <div class="text-center">
                <h2 class="section-title text-theme">Sobre Mí</h2>
                <div class="section-divider"></div>
            </div>
        </AnimateOnScroll>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <AnimateOnScroll delay={0.2} client:load>
                    <div
                        class="p-4 rounded-4"
                        style="background: var(--bg-card); border: 1px solid var(--bg-card-border);"
                    >
                        <p class="text-theme-muted fs-5 mb-4">
                            Soy un desarrollador web con pasión por construir
                            productos digitales que combinan funcionalidad y
                            estética. Me especializo en el stack moderno de
                            JavaScript/TypeScript.
                        </p>
                        <div class="row g-4">
                            <div class="col-md-4 text-center">
                                <div
                                    class="fs-1 fw-bold"
                                    style="color: #6366f1;"
                                >
                                    3+
                                </div>
                                <div class="text-theme-muted">
                                    Años de experiencia
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div
                                    class="fs-1 fw-bold"
                                    style="color: #06b6d4;"
                                >
                                    20+
                                </div>
                                <div class="text-theme-muted">
                                    Proyectos completados
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div
                                    class="fs-1 fw-bold"
                                    style="color: #a855f7;"
                                >
                                    10+
                                </div>
                                <div class="text-theme-muted">
                                    Clientes satisfechos
                                </div>
                            </div>
                        </div>
                    </div>
                </AnimateOnScroll>
            </div>
        </div>
    </div>
</section>
