---
const phone = "56912345678";
const message = encodeURIComponent(
    "Hola, vi tu portafolio y me gustaría contactarte",
);
const waUrl = `https://wa.me/${phone}?text=${message}`;
---

<section id="contacto">
    <div class="container">
        <div class="text-center">
            <h2 class="section-title text-white">Contacto</h2>
            <div class="section-divider"></div>
            <p class="text-white-50 mb-5">
                ¿Tienes un proyecto en mente? Hablemos.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <form
                    class="p-4 rounded-4"
                    style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);"
                >
                    <div class="mb-3">
                        <label class="form-label text-white-50">Nombre</label>
                        <input
                            type="text"
                            class="form-control bg-transparent text-white border-secondary"
                            placeholder="Tu nombre"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Email</label>
                        <input
                            type="email"
                            class="form-control bg-transparent text-white border-secondary"
                            placeholder="tu@email.com"
                        />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-50">Mensaje</label>
                        <textarea
                            class="form-control bg-transparent text-white border-secondary"
                            rows="5"
                            placeholder="Cuéntame sobre tu proyecto..."
                        ></textarea>
                    </div>
                    <button
                        type="submit"
                        class="btn btn-primary w-100 btn-lg rounded-pill"
                    >
                        Enviar mensaje →
                    </button>
                </form>

                <!-- Links sociales -->
                <div class="d-flex justify-content-center gap-4 mt-4">
                    <a
                        href="https://github.com"
                        target="_blank"
                        class="text-white-50 text-decoration-none">GitHub</a
                    >
                    <a
                        href="https://linkedin.com"
                        target="_blank"
                        class="text-white-50 text-decoration-none">LinkedIn</a
                    >
                    <a
                        href="mailto:tu@email.com"
                        class="text-white-50 text-decoration-none">Email</a
                    >
                    <a
                        href={waUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white-50 text-decoration-none d-flex align-items-center gap-1"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            fill="#25d366"
                            viewBox="0 0 32 32"
                        >
                            <path
                                d="M16 0C7.163 0 0 7.163 0 16c0 2.833.738 5.494 2.027 7.807L0 32l8.43-2.01A15.93 15.93 0 0 0 16 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm0 29.333a13.27 13.27 0 0 1-6.785-1.858l-.486-.29-5.005 1.194 1.225-4.872-.317-.5A13.24 13.24 0 0 1 2.667 16C2.667 8.636 8.636 2.667 16 2.667S29.333 8.636 29.333 16 23.364 29.333 16 29.333zm7.27-9.878c-.398-.199-2.358-1.162-2.724-1.295-.366-.133-.632-.199-.898.199-.266.398-1.03 1.295-1.263 1.561-.232.266-.465.299-.863.1-.398-.2-1.68-.619-3.2-1.974-1.183-1.054-1.981-2.356-2.213-2.754-.232-.398-.025-.613.175-.811.18-.178.398-.465.597-.698.2-.232.266-.398.398-.664.133-.266.067-.498-.033-.697-.1-.2-.898-2.163-1.23-2.96-.324-.778-.654-.672-.898-.685l-.765-.013c-.266 0-.697.1-1.063.498-.366.398-1.395 1.362-1.395 3.325 0 1.963 1.428 3.86 1.628 4.126.2.266 2.81 4.29 6.81 6.018.952.41 1.695.656 2.274.839.955.303 1.825.26 2.512.158.766-.114 2.358-.964 2.691-1.895.333-.931.333-1.729.232-1.895-.1-.166-.366-.266-.764-.465z"
                            ></path>
                        </svg>
                        WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
